      "node_modules/pi-web-access"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "bundledDependencies": [
    "pi-web-access"
  ],
  "devDependencies": {
    "typescript": "^5.2.2"
  },
  "license": "MIT",
  "dependencies": {
    "pi-web-access": "^0.19.0"
  },
  "bundleDependencies": [
    "pi-web-access"
  ]
}
