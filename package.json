{
  "name": "pi-agent-preset",
  "version": "0.1.0",
  "description": "A preset package for Pi agents, providing a set of extensions and configurations to enhance the capabilities of Pi agents.",
  "keywords": [
    "pi-package"
  ],
  "main": "dist/extensions/permission/index.js",
  "files": [
    "extensions",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "pi": {
    "extensions": [
